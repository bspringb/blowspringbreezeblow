---
import HeaderLink from './HeaderLink.astro';
import { getNavTypeGroups } from '../lib/objectNav';

const groups = await getNavTypeGroups();
const base = import.meta.env.BASE_URL;
---

<div class="nav-links-wrap">
	<HeaderLink href={`${base}texts`} class="texts-link">Texts</HeaderLink>
	<div class="blind-wrap">
		<div class="nav-links" id="nav-links">
			{
				groups.map((group) => (
					<div class="hover-menu" data-nav-item data-priority={group.isPriority ? 'true' : undefined}>
						<HeaderLink href={`${base}${group.href}`}>{group.type}<span class="type-count">({group.count})</span></HeaderLink>
						{group.children.length > 0 && (
							<div class="hover-popup">
								{group.selfHref && (
									<a href={`${base}${group.selfHref}`}>
										{group.type}<span class="item-count">({group.count})</span>
									</a>
								)}
								{group.children.map((child) => (
									<a href={`${base}objects/type/${child.type}`}>
										{child.type}<span class="item-count">({child.count})</span>
									</a>
								))}
							</div>
						)}
					</div>
				))
			}
		</div>
		<button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" hidden>
			<span class="nav-toggle-label">펼치기</span><span class="nav-toggle-arrow"></span>
		</button>
		<div class="nav-overflow" id="nav-overflow"></div>
	</div>
</div>

<style>
	.nav-links-wrap {
		display: flex;
		align-items: flex-start;
		gap: 1.5em;
		flex: 1 1 auto;
		min-width: 0;
	}
	.blind-wrap {
		position: relative;
		display: flex;
		align-items: center;
		flex: 1 1 auto;
		min-width: 0;
		/* 시작 위치(Texts 바로 다음)는 그대로 두고 상시표시 줄의 폭만 줄인다 —
		   오버플로우 판정 기준도 이 요소의 실제 폭이라 자동으로 더 일찍 넘친다. */
		max-width: 45%;
	}
	/* 항상 보이는 한 줄 — 여기 들어있는 항목은 펼치기와 무관하게 자기 자리에 그대로 있다 */
	.nav-links {
		display: flex;
		flex: 0 1 auto;
		flex-wrap: nowrap;
		align-items: center;
		overflow: hidden;
		min-width: 0;
		height: 1.8em;
	}
	/* 한 줄에 남아있는 항목을 호버할 때만 클리핑을 잠시 풀어서 팝업이 안 잘리게 */
	.nav-links:has(.hover-menu:hover),
	.nav-links:has(.hover-menu:focus-within) {
		overflow: visible;
	}
	.nav-toggle {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		background: none;
		border: none;
		color: var(--ink-dim);
		font-family: var(--font-sans);
		font-size: 0.65em;
		font-weight: 400;
		cursor: pointer;
		padding: 0.4em 0.5em 0em;
	}
	.nav-toggle:hover {
		color: var(--accent-bright);
	}
	/* ▾ 유니코드 글리프는 폰트마다 상하좌우 여백(bearing)이 비대칭이라, 아무리
	   박스를 정확히 맞춰도 글자 자체가 박스 중심에 안 그려져서 회전시키면 위치가
	   틀어진다. 폰트에 아예 의존하지 않는 순수 CSS 삼각형(border trick)으로
	   그리면 기하학적으로 완전 대칭이라 180도 회전해도 제자리에서만 돈다.
	   버튼을 flex로 만들어 align-items:center로 세로 중앙을 맞춘다 — 삼각형은
	   테두리로만 그려서 박스 높이가 0이라 vertical-align 기준의 정렬은 안 맞는다. */
	.nav-toggle-arrow {
		display: inline-block;
		flex: 0 0 auto;
		width: 0;
		height: 0;
		/* border-top만 있어서 보이는 삼각형이 이 박스(높이 0)보다 위쪽으로만
		   그려진다 — flex가 중앙 정렬하는 건 이 안 보이는 0높이 박스라서,
		   실제 삼각형은 그만큼(테두리 두께의 절반) 위로 떠 보인다. 절반만큼
		   아래로 밀어서 시각적 중심을 flex 중앙선에 맞춘다. */
		margin-top: 3px;
		border-left: 4px solid transparent;
		border-right: 4px solid transparent;
		border-top: 5px solid currentColor;
		transition: transform 0.15s ease;
	}
	.nav-toggle.is-open .nav-toggle-arrow {
		transform: rotate(180deg);
	}
	/* 안 보이던(넘쳤던) 항목만 여기로 옮겨져서, 검색창 자동완성처럼 아래에 붙어 뜬다.
	   구글/사파리 주소창처럼 각지고 그림자만 있는 드롭다운 — 팝업 카드 아님.
	   초성별로 줄을 나눠서 보여주므로 세로(column) 방향으로 쌓는다. */
	.nav-overflow {
		display: none;
		position: absolute;
		top: 108%;
		left: 0;
		width: 83%;
		flex-direction: column;
		gap: 0.1em;
		background: var(--bg);
		border: 1px solid var(--rule);
		box-shadow: 0px;
		padding: 0em 0.4em 0.3em 0.4em;
		z-index: 20;
	}
	.nav-overflow.open {
		display: flex;
	}
	/* 상시표시 줄은 은은하게(ink-dim), 펼쳐진 패널 안에서는 또렷하게 보여야
	   "숨겨졌던 항목들"이라는 느낌이 나고 읽기도 편하다. 항목 수가 늘어난 만큼
	   글자 크기/패딩은 상시표시 줄보다 더 작고 촘촘하게 잡는다. */
	.nav-overflow :global(a) {
		color: var(--ink);
		font-size: 0.75em;
		padding: 0.05em 0.25em 0em;
	}
	.nav-overflow :global(a:hover) {
		text-decoration: underline;
		/* 안에 있는 .type-count가 더 어두운 색(--ink-dim)이라, 색을 안 정해주면
		   밑줄이 그 부분만 currentColor를 따라가서 어둡게 끊겨 보인다.
		   전체를 한 가지 색(--ink, 밝은 색)으로 고정한다. */
		text-decoration-color: var(--ink);
		/* .type-count가 글자 크기가 훨씬 작아서(0.53em), 그 구간만 밑줄 두께가
		   상대적으로 두꺼워 보이고 괄호 아랫부분과 겹쳐 뭉개져 보인다.
		   두께/오프셋을 고정값으로 못박아 크기가 다른 글자 사이에서도 밑줄이
		   가늘고 일정한 위치에 오게 한다. */
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}
	/* 넘침 처리됐지만 우선순위 목록에 있던 항목들 — 초성 묶음과 섞이지 않게
	   맨 위 별도 줄에, 구분선을 두고 보여준다.
	   이 아래 세 클래스는 전부 스크립트가 document.createElement로 만드는
	   요소라, 정적 템플릿에 없어서 Astro의 스코프 속성이 안 찍힌다 —
	   :global()로 안 감싸면 아무리 값을 바꿔도 실제로는 하나도 안 먹는다. */
	:global(.nav-overflow-pinned) {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.1em 0.2em;
		padding-bottom: 0.2em;
		border-bottom: 1px solid var(--rule);
	}
	:global(.nav-overflow-row) {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.1em 0.2em;
	}
	:global(.chosung-label) {
		flex: 0 0 auto;
		font-family: var(--font-sans);
		font-size: 0.65em;
		font-weight: 400;
		color: rgba(234, 232, 232, 0.753);
		margin-right: 0.15em;
	}
	.nav-links-wrap :global(a) {
		padding: 0.4em 0.5em 0em;
		color: var(--ink-dim);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-family: var(--font-serif);
		font-size: 0.75em;
		letter-spacing: 0.04em;
	}
	/* Texts만 따로 살짝 아래로 내림 */
	.nav-links-wrap :global(a.texts-link) {
		padding-top: 0.55em;
	}
	.nav-links-wrap :global(a.active) {
		color: var(--ink);
		text-decoration: none;
		border-bottom-color: var(--accent-bright);
	}
	.hover-menu {
		position: relative;
		display: inline-block;
		flex: 0 0 auto;
		white-space: nowrap;
	}
	.hover-popup {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		flex-direction: column;
		min-width: 5em;
		background: var(--bg);
		border: 1px solid var(--rule);
		border-radius: 2px;
		padding: 0;
		z-index: 30;
	}
	.hover-popup a {
		padding: 0.1em 0.5em;
		border-bottom: 1px solid var(--rule);
	}
	.hover-popup a:last-child {
		border-bottom: none;
	}
	.hover-popup a:hover {
		background: var(--bg-raised);
	}
	/* 호버 팝업 안의 개수는 항상 보임 — 클릭 안 하고 미리보는 자리라 부담 없다. */
	.item-count {
		font-size: 0.65em;
		font-weight: 400;
		color: var(--ink-dim);
		margin-left: 0.05em;
	}
	/* 최상위 항목 자신의 개수는 상시표시 줄에서는 숨긴다(폭이 좁아 오버플로우가
	   더 잘 일어남) — 펼치기 드롭다운으로 넘어갔을 때(#nav-overflow 안)만 보인다. */
	.type-count {
		display: none;
		font-size: 0.6em;
		font-weight: 400;
		color: var(--ink-dim);
		margin-left: 0.05em;
	}
	#nav-overflow .type-count {
		display: inline;
	}
	.hover-menu:hover .hover-popup,
	.hover-menu:focus-within .hover-popup {
		display: flex;
	}
</style>

<script>
	const container = document.getElementById('nav-links');
	const toggle = document.getElementById('nav-toggle');
	const toggleLabel = toggle?.querySelector('.nav-toggle-label');
	const overflowPanel = document.getElementById('nav-overflow');

	// 넘침 판단 기준은 nav-links 자신이 아니라 부모(blind-wrap)여야 한다 —
	// nav-links는 flex:0 1 auto라 콘텐츠 크기만큼만 차지해서(shrink-to-fit)
	// 오른쪽에 여유 공간이 전혀 없고, 그 자기 오른쪽 끝에서 60px를 빼면 실제
	// 화면에 남는 공간과 무관하게 항상 마지막 항목 한두 개가 넘친 것으로
	// 잘못 판정된다.
	const wrap = container?.parentElement;

	// 한글 초성 19개(유니코드 완성형 한글의 분해 순서와 동일). 첫 글자가 이
	// 목록에 안 걸리면(한글 완성형이 아니면) '#'으로 묶는다.
	const CHOSUNG_LIST = [
		'ㄱ', 'ㄲ', 'ㄴ', 'ㄷ', 'ㄸ', 'ㄹ', 'ㅁ', 'ㅂ', 'ㅃ', 'ㅅ',
		'ㅆ', 'ㅇ', 'ㅈ', 'ㅉ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ',
	];

	function getChosung(text: string): string {
		const code = (text.charCodeAt(0) ?? 0) - 0xac00;
		if (code < 0 || code > 11171) return '#';
		return CHOSUNG_LIST[Math.floor(code / 588)];
	}

	function itemLabel(item: HTMLElement): string {
		return item.querySelector(':scope > a')?.textContent?.trim() ?? '';
	}

	if (container && wrap && toggle && overflowPanel) {
		const items = Array.from(container.querySelectorAll<HTMLElement>(':scope > [data-nav-item]'));
		// "펼치기 ▾" 버튼의 실제 렌더링 폭(한글 3글자+화살표+좌우 패딩)은 60px보다
		// 넓어서, 여유를 너무 박하게 잡으면 버튼에 밀린 nav-links가 마지막 "안전"
		// 항목 텍스트를 잘라먹을 수 있다. 넉넉하게 잡는다.
		const TOGGLE_RESERVED_WIDTH = 100;

		const layout = () => {
			// 측정을 정확히 하기 위해 일단 전부 원래 자리(한 줄)로 되돌린다.
			items.forEach((item) => container.appendChild(item));

			const wrapRect = wrap.getBoundingClientRect();
			const limit = wrapRect.right - TOGGLE_RESERVED_WIDTH;

			const overflowing = items.filter((item) => item.getBoundingClientRect().right > limit);

			overflowPanel.innerHTML = '';

			// 우선순위 목록에 있었는데도 폭이 모자라 밀린 항목은 맨 위 별도 줄에
			// 구분선을 두고 "추가로" 보여준다 — 초성 부분에서는 빠지지 않고,
			// 우선순위와 무관하게 넘친 항목 전체가 항상 그대로 다 나온다(완전한 색인).
			// 같은 노드를 두 곳에 동시에 넣을 수는 없으므로(append하면 이동돼버림),
			// 초성 쪽에는 복제본을 넣는다.
			const pinned = overflowing.filter((item) => item.dataset.priority === 'true');

			if (pinned.length > 0) {
				const pinnedRow = document.createElement('div');
				pinnedRow.className = 'nav-overflow-pinned';
				pinnedRow.append(...pinned);
				overflowPanel.appendChild(pinnedRow);
			}

			// 초성 목록은 넘친 것만이 아니라 헤더에 그대로 남아있는 항목까지
			// 포함해서 전체를 대상으로 한다 — 어디 있든 상관없이 항상 완전한
			// 색인이 되게. 원본이 다른 자리(헤더 또는 고정줄)에 있어야 하는
			// 경우에만 복제본을 넣고, 넘쳐서 초성 줄이 유일한 자리인 항목만
			// 원본을 그대로 옮긴다(불필요한 복제 방지).
			const byChosung = new Map<string, HTMLElement[]>();
			for (const item of items) {
				const isOverflowing = overflowing.includes(item);
				const isPinned = item.dataset.priority === 'true';
				const node = !isOverflowing || isPinned ? (item.cloneNode(true) as HTMLElement) : item;
				const ch = getChosung(itemLabel(item));
				if (!byChosung.has(ch)) byChosung.set(ch, []);
				byChosung.get(ch)!.push(node);
			}

			for (const ch of [...CHOSUNG_LIST, '#']) {
				const groupItems = byChosung.get(ch);
				if (!groupItems || groupItems.length === 0) continue;

				const row = document.createElement('div');
				row.className = 'nav-overflow-row';
				const label = document.createElement('span');
				label.className = 'chosung-label';
				label.textContent = ch;
				row.appendChild(label);
				row.append(...groupItems);
				overflowPanel.appendChild(row);
			}

			toggle.hidden = overflowing.length === 0;
			if (overflowing.length === 0) {
				overflowPanel.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.classList.remove('is-open');
				if (toggleLabel) toggleLabel.textContent = '펼치기';
			}
		};

		toggle.addEventListener('click', () => {
			const open = overflowPanel.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(open));
			toggle.classList.toggle('is-open', open);
			if (toggleLabel) toggleLabel.textContent = open ? '접기' : '펼치기';
		});

		window.addEventListener('resize', layout);
		layout();
	}
</script>
